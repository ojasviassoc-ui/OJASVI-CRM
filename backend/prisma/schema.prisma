generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  TEAM_LEADER
  SALES_EXECUTIVE
  TELECALLER
}

enum LeadStatus {
  NEW
  ASSIGNED
  FIRST_CALL
  FOLLOW_UP
  INTERESTED
  NOT_INTERESTED
  BUSY
  SWITCHED_OFF
  WRONG_NUMBER
  CALL_BACK
  MEETING_FIXED
  SALE_COMPLETED
  CLOSED
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdCampaigns Campaign[] @relation("CampaignCreator")

  telecallerAssignments LeadAssignment[] @relation("TelecallerAssignments")
  callHistories         CallHistory[]
}

model VehicleLead {
  id String @id @default(cuid())

  vehicleNo String  @unique
  chassisNo String?

  makerName  String?
  makerClass String?

  manufacturingYear  Int?
  registrationDate   DateTime?
  registrationSeries String?

  motorClass String?

  ownerName String?

  financier String?

  phoneNumber String?

  status LeadStatus @default(NEW)

  remarks String?

  callAttempts Int @default(0)

  nextFollowUp DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments LeadAssignment[]

  callHistory CallHistory[]
}

model Campaign {
  id String @id @default(cuid())

  campaignName String

  totalLeads Int @default(0)

  createdById String

  createdAt DateTime @default(now())

  createdBy User @relation("CampaignCreator", fields: [createdById], references: [id])

  assignments LeadAssignment[]
}

model LeadAssignment {
  id String @id @default(cuid())

  leadId String

  telecallerId String

  campaignId String

  assignedAt DateTime @default(now())

  releasedAt DateTime?

  isCompleted Boolean @default(false)

  lead VehicleLead @relation(fields: [leadId], references: [id])

  telecaller User @relation("TelecallerAssignments", fields: [telecallerId], references: [id])

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model CallHistory {
  id String @id @default(cuid())

  leadId String

  telecallerId String

  status LeadStatus

  remarks String?

  nextFollowUp DateTime?

  createdAt DateTime @default(now())

  lead VehicleLead @relation(fields: [leadId], references: [id])

  telecaller User @relation(fields: [telecallerId], references: [id])
}
